# Environment Variables Template

# Copy this file to .env.local and fill in your values

# Appwrite
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://[HOSTNAME_OR_IP]/v1
NEXT_PUBLIC_APPWRITE_PROJECT=your_appwrite_project_id
APPWRITE_DATABASE_ID=your_appwrite_database_id
APPWRITE_API_KEY=your_appwrite_api_key
APPWRITE_AUTHORS_COLLECTION_ID=authors_collection_id
APPWRITE_POSTS_COLLECTION_ID=posts_collection_id
APPWRITE_COMMENTS_COLLECTION_ID=comments_collection_id
APPWRITE_LIKES_COLLECTION_ID=likes_collection_id
APPWRITE_SAVES_COLLECTION_ID=saves_collection_id
APPWRITE_USER_COLLECTIONS_COLLECTION_ID=user_collections_collection_id
APPWRITE_COLLECTION_ITEMS_COLLECTION_ID=collection_items_collection_id

